<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block titulo %}kingsrace{% endblock %}</title>
<meta name="description" content="{% block descricao %}{% endblock %}">
<meta property="og:type" content="article">
<meta property="og:locale" content="pt_BR">
<meta property="og:title" content="{{ self.titulo() }}">
<meta property="og:description" content="{{ self.descricao() }}">
<meta name="twitter:card" content="summary">
<meta name="color-scheme" content="light dark">
<link rel="preload" href="{{ raiz }}estatico/fontes/archivo-wdth.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ raiz }}estatico/fontes/ibm-plex-sans-wght.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ raiz }}estatico/css/tema.css">
<link rel="stylesheet" href="{{ raiz }}estatico/css/componentes.css">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='2' y='17' width='12' height='13' rx='2' fill='%23e34948'/%3E%3Crect x='18' y='9' width='12' height='21' rx='2' fill='%232a78d6'/%3E%3C/svg%3E">
{% block head %}{% endblock %}
</head>
<body>
{% block corpo %}{% endblock %}
<footer class="coluna">
  {% block rodape %}{% endblock %}
  <p>Código e dados: projeto kingsrace, com dados públicos do TSE, do IBGE e do MDS. Cada número desta página vem de uma etapa versionada do pipeline (DVC), na revisão <span class="num">{{ commit }}</span>; página montada em {{ montado_em }}.</p>
</footer>
</body>
</html>
